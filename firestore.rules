/**
 * @fileoverview Firestore Security Rules for Contador de Quesitos App
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and allows authenticated users to create "quesitos".
 * It prioritizes security and scalability by using path-based ownership and structural segregation.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, with the `userId` as the document ID.
 * - /quesitos/{quesitoId}: Stores "quesitos", with a denormalized `userId` field for authorization.
 *
 * Key Security Decisions:
 * - Only authenticated users can create "quesitos."
 * - Users can only read and write their own profile data.
 * - Listing of all "quesitos" is allowed for all users.
 *
 * Denormalization for Authorization:
 * The `quesitos` collection denormalizes the `userId` to avoid `get()` calls for ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile at /users/user123.
     * @allow (get, update, delete) - User with UID 'user123' can read/update/delete their profile at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, update, delete) - User with UID 'user456' cannot read/update/delete the profile at /users/user123.
     * @principle Enforces document ownership for user profiles, restricting access to the owner only.
     */
    match /users/{userId} {
      // Function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Function to check if the requested user ID matches the authenticated user's ID.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Function to check if the requested user ID matches the authenticated user's ID.
      function isExistingOwner(userId) {
        return isOwner(userId);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to "quesito" documents.
     * @path /quesitos/{quesitoId}
     * @allow (create) - Authenticated user can create a "quesito" with their UID in the 'userId' field.
     * @allow (get, list) - Any user can read any "quesito".
     * @deny (update, delete) - User with UID 'user456' cannot update/delete a quesito created by user 'user123'.
     * @principle Allows public read access to "quesitos" but restricts modifications to the owner.
     */
    match /quesitos/{quesitoId} {

      function isSignedIn() {
        return request.auth != null;
      }

      // Function to check if the user is the owner of the quesito
      function isOwner(resourceUserId) {
        return request.auth.uid == resourceUserId;
      }

      function isExistingOwner(resourceUserId) {
        return isSignedIn() && isOwner(resourceUserId);
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }
  }
}