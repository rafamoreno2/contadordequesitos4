/**
 * @file Firestore Security Rules for Contador de Quesitos
 *
 * @Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and quesitos nested under the `/users/{userId}` path.
 * The `/quesitos` collection allows public read access with owner-only writes.
 *
 * @Data Structure:
 * - `/users/{userId}`: Stores user profile information, accessible only to the owning user.
 * - `/users/{userId}/quesitos/{quesitoId}`: Stores quesitos created by a specific user, accessible only to that user. Each quesito includes a denormalized `userId` field for authorization.
 * - `/quesitos/{quesitoId}`: Stores all quesitos added by all users, enabling a global feed. Includes a `userId` field to identify the creator.
 * - `/app_metadata/{appMetadataId}`: Stores app-wide metadata.
 *
 * @Key Security Decisions:
 * - Users can only access their own profile data.
 * - Users can only manage quesitos they created under their user ID.
 * - The global `/quesitos` collection allows public read access, but only the owner can create, update, or delete a quesito.
 * - Listing of quesitos is enabled at the global level and within the user's scope.
 * - App metadata is locked down to prevent unauthorized modifications.
 *
 * @Denormalization for Authorization:
 * - Quesito documents in both `/quesitos/{quesitoId}` and `/users/{userId}/quesitos/{quesitoId}` collections include a `userId` field. This denormalization allows for ownership checks without additional `get()` operations.
 *   For example, rules on `/quesitos/{quesitoId}` can directly check `resource.data.userId == request.auth.uid` to verify ownership.
 *
 * @Structural Segregation:
 * - Quesitos are stored in both a public top-level collection (`/quesitos`) and in a private user subcollection (`/users/{userId}/quesitos`). This allows for public listing of all quesitos, while still maintaining user-specific private lists.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description: Allows users to read and write their own profile data.
     * @path: /users/{userId}
     * @allow: User with UID 'user123' (create, update, get) their own profile at /users/user123.
     * @deny: User with UID 'user456' (create, update, get) the profile of user 'user123' at /users/user123.
     * @principle: Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Create: Only allow if the user is signed in and the userId matches the authenticated user's UID.
      allow create: if isSignedIn() && isOwner(userId);

      // Get: Only allow if the user is signed in and the userId matches the authenticated user's UID.
      allow get: if isSignedIn() && isOwner(userId);

      // List:  No listing of all users is allowed.
      allow list: if false;

      // Update: Only allow if the user is signed in, the userId matches the authenticated user's UID, and the document exists. Also, ensure the userId field is immutable.
      allow update: if isSignedIn() && isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));

      // Delete: Only allow if the user is signed in, the userId matches the authenticated user's UID, and the document exists.
      allow delete: if isSignedIn() && isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description: Allows users to manage their own quesitos under their user path.
     * @path: /users/{userId}/quesitos/{quesitoId}
     * @allow: User with UID 'user123' (create, update, get, delete, list) their own quesito at /users/user123/quesitos/quesitoXYZ.
     * @deny: User with UID 'user456' (create, update, get, delete, list) the quesito of user 'user123' at /users/user123/quesitos/quesitoXYZ.
     * @principle: Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId}/quesitos/{quesitoId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      // Create: Only allow if the user is signed in and the userId matches the authenticated user's UID. Validate that the quesito's userId matches the path.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == request.auth.uid;

      // Get: Only allow if the user is signed in and the userId matches the authenticated user's UID.
      allow get: if isSignedIn() && isOwner(userId);

      // List: Only allow if the user is signed in and the userId matches the authenticated user's UID.
      allow list: if isSignedIn() && isOwner(userId);

      // Update: Only allow if the user is signed in, the userId matches the authenticated user's UID, and the document exists. Enforce immutability of userId.
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data.userId == resource.data.userId && exists(/databases/$(database)/documents/users/$(userId)/quesitos/$(quesitoId));

      // Delete: Only allow if the user is signed in, the userId matches the authenticated user's UID, and the document exists.
      allow delete: if isSignedIn() && isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId)/quesitos/$(quesitoId));
    }

    /**
     * @description: Allows public read access to quesitos, but restricts writes to the owner.
     * @path: /quesitos/{quesitoId}
     * @allow: Any user (get, list) any quesito. User with UID 'user123' (create, update, delete) their own quesito at /quesitos/quesitoXYZ.
     * @deny: User with UID 'user456' (create, update, delete) the quesito of user 'user123' at /quesitos/quesitoXYZ.
     * @principle: Allows public read access with owner-only writes.
     */
    match /quesitos/{quesitoId} {
      function isSignedIn() {
        return request.auth != null;
      }

      // Get: Allow anyone to read quesitos.
      allow get: if true;

      // List: Allow anyone to list quesitos.
      allow list: if true;

      // Create: Only allow if the user is signed in and the userId in the request data matches the authenticated user's UID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Update: Only allow if the user is signed in, the userId matches the authenticated user's UID, and the document exists.
      allow update: if isSignedIn() && request.resource.data.userId == request.auth.uid && exists(/databases/$(database)/documents/quesitos/$(quesitoId));

      // Delete: Only allow if the user is signed in, the userId matches the authenticated user's UID, and the document exists.
      allow delete: if isSignedIn() && request.resource.data.userId == request.auth.uid && exists(/databases/$(database)/documents/quesitos/$(quesitoId));
    }

    /**
     * @description: Restricts access to app metadata. No one should be able to read or modify.
     * @path: /app_metadata/{appMetadataId}
     * @allow: (none)
     * @deny: Any user (create, update, get, delete, list) the app metadata.
     * @principle: Restricts access to sensitive app configuration data.
     */
    match /app_metadata/{appMetadataId} {
      // No one can create, get, list, update, or delete app metadata.
      allow create: if false;
      allow get: if false;
      allow list: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}