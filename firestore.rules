/**
 * @fileoverview Firestore Security Rules for the Contador de Quesitos app.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and allows public read access to quesitos, but restricts writes to quesitos to authenticated users and their owners.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profile information, accessible only to the user themselves.
 * - `/quesitos/{quesitoId}`: Stores quesitos added by users.  Any logged in user can create quesitos. Quesitos are publicly readable.  Only the owner (creator) can update or delete them.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Listing users is not allowed.
 * - Quesitos are publicly readable to encourage discovery and engagement.
 * - Only the creator of a quesito can modify or delete it.
 *
 * Denormalization for Authorization:
 * - The `quesitos` collection denormalizes the `userId` to allow for owner-based access control without additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their own profile document at /users/user_abc.
     * @allow (get, update, delete) - User with UID 'user_abc' can read, update, and delete their own profile document at /users/user_abc.
     * @deny (create) - User with UID 'user_abc' cannot create a profile document for another user (e.g., /users/user_xyz).
     * @deny (update, delete) - User with UID 'user_abc' cannot update or delete another user's profile document (e.g., /users/user_xyz).
     * @deny (list) - No one can list all user documents.
     * @principle Enforces document ownership for user profiles; restricts listing for privacy.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Controls access to quesito documents.  Allows public read, owner-only updates/deletes.
     * @path /quesitos/{quesitoId}
     * @allow (get, list) - Any user, even unauthenticated, can read any quesito.
     * @allow (create) - User with UID 'user_abc' can create a quesito with userId: 'user_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot update or delete a quesito created by 'user_abc'.
     * @principle Allows public read access, enforces ownership for writes.
     */
    match /quesitos/{quesitoId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(resource.data.userId);
      allow delete: if isSignedIn() && isExistingOwner(resource.data.userId);
    }
  }
}