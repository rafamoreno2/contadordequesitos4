/**
 * @fileOverview Firestore Security Rules for Contador de Quesitos App
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and allows public read access to "quesitos" while restricting write access to the owner of the quesito.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only by the user themselves.
 * - /quesitos/{quesitoId}: Stores quesitos, publicly readable but writable only by the quesito's creator.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Anyone can list and get quesitos.
 * - Only the creator of a quesito can modify or delete it.
 * - Denormalization: The `quesitos` collection includes a `userId` field to avoid costly `get()` calls when enforcing ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their own profile.
     *   request.auth.uid == 'user123' && request.resource.data.id == 'user123'
     * @allow (get, update, delete) User with ID 'user123' reads/updates/deletes their own profile.
     *   request.auth.uid == 'user123'
     * @deny (create) User with ID 'user456' attempts to create profile for 'user123'.
     *   request.auth.uid == 'user456' && request.resource.data.id == 'user123'
     * @deny (get, update, delete) User with ID 'user456' attempts to read/update/delete profile for 'user123'.
     *   request.auth.uid == 'user456'
     * @principle Enforces document ownership and relational integrity.
     */
    match /users/{userId} {
      // Allow anyone to get a user document
      allow get: if true;
      // Allow the user to list a user documents
      allow list: if false;

      // Allow a user to create their own document, enforcing that the userId matches the authenticated user's ID.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;

      // Allow a user to update and delete their own document.  The document must exist.
      allow update, delete: if isSignedIn() && isExistingOwner(userId) && resource.data.id == request.resource.data.id;


      function isOwner(userId) {
        return request.auth.uid == userId;
      }

       function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
    }

    /**
     * @description Controls access to quesito documents. Allows public reads, but restricts writes to the owner of the quesito.
     * @path /quesitos/{quesitoId}
     * @allow (get, list) Anyone can read quesitos.
     * @allow (create) User with ID 'user123' creates a quesito with userId 'user123'.
     *   request.auth.uid == 'user123' && request.resource.data.userId == 'user123'
     * @allow (update, delete) User with ID 'user123' updates/deletes a quesito they own (userId matches).
     *   request.auth.uid == 'user123' && resource.data.userId == 'user123'
     * @deny (create) User with ID 'user456' attempts to create a quesito with userId 'user123'.
     *   request.auth.uid == 'user456' && request.resource.data.userId == 'user123'
     * @deny (update, delete) User with ID 'user456' attempts to update/delete a quesito owned by 'user123'.
     *   request.auth.uid == 'user456' && resource.data.userId == 'user123'
     * @principle Allows public read access to quesitos while enforcing document ownership for writes.
     */
    match /quesitos/{quesitoId} {
      // Allow anyone to read quesitos
      allow get, list: if true;

      // Allow a user to create a quesito, enforcing that the userId matches the authenticated user's ID.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Allow a user to update and delete their own quesito. The document must exist.
      allow update, delete: if isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    // Helper function to determine if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
  }
}