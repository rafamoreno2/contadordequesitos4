/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for user profiles and a public-read, owner-write model for the global "quesitos" collection.
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the owning user.
 * - /users/{userId}/quesitos/{quesitoId}: Stores quesitos created by a specific user, accessible only to the owning user.
 * - /quesitos/{quesitoId}: Stores all quesitos. Readable by anyone, but only the creator can modify or delete.
 * - /app_metadata/{appMetadataId}: Stores app metadata, read and writable by anyone (consider restricting in production).
 * Key Security Decisions:
 * - User data is strictly private. No listing of users is allowed.
 * - The /quesitos collection is publicly readable to facilitate the global list, but writes are restricted to the owner.
 * - Access to /app_metadata is open.
 * Denormalization for Authorization:
 * - The /quesitos collection stores the userId, avoiding costly get() calls to the /users collection for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles. Only the user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile at /users/user123.
     * @allow (get) User with ID 'user123' reads their profile at /users/user123.
     * @allow (update) User with ID 'user123' updates their profile at /users/user123.
     * @allow (delete) User with ID 'user123' deletes their profile at /users/user123.
     * @deny (create) User with ID 'user123' attempts to create a profile at /users/user456.
     * @deny (get) User with ID 'user123' attempts to read the profile at /users/user456.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Enforces user-ownership for quesitos within a user's subcollection.
     * @path /users/{userId}/quesitos/{quesitoId}
     * @allow (create) User 'user123' creates a quesito with ID 'quesito456' under /users/user123/quesitos/quesito456.
     * @allow (get) User 'user123' reads quesito 'quesito456' under /users/user123/quesitos/quesito456.
     * @allow (update) User 'user123' updates quesito 'quesito456' under /users/user123/quesitos/quesito456.
     * @allow (delete) User 'user123' deletes quesito 'quesito456' under /users/user123/quesitos/quesito456.
     * @deny (create) User 'user123' attempts to create a quesito under /users/user456/quesitos/quesito456.
     * @deny (get) User 'user123' attempts to read a quesito under /users/user456/quesitos/quesito456.
     * @principle Enforces document ownership and prevents unauthorized access.
     */
    match /users/{userId}/quesitos/{quesitoId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows public read access to quesitos, but restricts write access to the owner of the quesito.
     * @path /quesitos/{quesitoId}
     * @allow (get) Any user can read a quesito with ID 'quesito123' from /quesitos/quesito123.
     * @allow (list) Any user can list quesitos in the /quesitos collection.
     * @allow (create) User 'user123' creates a quesito with ID 'quesito456' in /quesitos/quesito456 where request.resource.data.userId == 'user123'.
     * @allow (update) User 'user123' updates their quesito with ID 'quesito456' in /quesitos/quesito456 where resource.data.userId == 'user123'.
     * @allow (delete) User 'user123' deletes their quesito with ID 'quesito456' in /quesitos/quesito456 where resource.data.userId == 'user123'.
     * @deny (create) User 'user13' attempts to create a quesito in /quesitos/quesito456 where request.resource.data.userId != 'user123'.
     * @deny (update) User 'user123' attempts to update quesito with ID 'quesito456' in /quesitos/quesito456 where resource.data.userId != 'user123'.
     * @principle Allows public read with owner-only writes, validates ownership on create, update, and delete.
     */
    match /quesitos/{quesitoId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.userId);
      allow delete: if isExistingOwner(resource.data.userId);
    }

    /**
     * @description Allows anyone to read and write app metadata.  Consider restricting writes in production.
     * @path /app_metadata/{appMetadataId}
     * @allow (get) Any user can read the app metadata.
     * @allow (list) Any user can list the app metadata.
     * @allow (create) Any user can create app metadata.
     * @allow (update) Any user can update app metadata.
     * @allow (delete) Any user can delete app metadata.
     * @principle Allows public read and write access.
     */
    match /app_metadata/{appMetadataId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}